  name: "rem_expectativa"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v1/rems/ultimo"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "rems"
            }
            {
              lit: "ultimo"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
