  "requests": {
    "GET /v1/rems/{año}/{mes}": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "get-rems-anio-mes",
        "parameters": [
          {
            "description": "Año del informe REM",
            "example": 2026,
